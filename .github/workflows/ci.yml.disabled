# Disabled in the template: GitHub only runs *.yml / *.yaml files in this folder.
# Bootstrap renames this file to ci.yml and fills in the TODO.

name: CI

on:
  push:
    branches: [master]
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
